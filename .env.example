# Connexion Neon (Project Settings → Connection string → "Pooled connection")
# Le paramètre sslmode=require est nécessaire.
DATABASE_URL=postgresql://user:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Mot de passe de l'espace /#admin. Choisir une valeur longue, jamais "123456".
ADMIN_PASSWORD=

# Notifications Web Push (obligatoires pour que les téléphones sonnent)
# Générer une paire de clés :
#   npx web-push generate-vapid-keys
# Les mêmes valeurs doivent être ajoutées dans les variables d'environnement Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact technique envoyé au service de push (URL du site ou mailto:)
VAPID_SUBJECT=https://bely-mechoui.vercel.app
